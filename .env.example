# Frontend (Vite) environment variables.
# Copy this file to `.env` and fill in real values. See `backend/.env.example`
# for backend (FastAPI) configuration.

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend API ---
# Default points at the local FastAPI dev server. In production this is set
# in the Vercel dashboard to the Railway-hosted backend URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Feature flags ---
# AI Conversation card on /practice. "true" links the card to /conversations;
# otherwise the card renders as "Coming soon".
VITE_AI_CONVERSATION_ENABLED=false

# AI Tutor speech feature (Spec 1+). Set to "true" to enable the /ai-tutor route
# tree, the homepage CTA swap, and the sidebar entry.
VITE_AI_TUTOR_ENABLED=false

# Maximum recording length in milliseconds. Auto-submits at this cap.
# Default: 20 seconds.
VITE_TUTOR_MAX_RECORD_MS=20000

# Supabase Pro "Image Transforms" gate. Set to "true" ONLY if the project has
# the paid render endpoint enabled — free tier returns FeatureNotEnabled and
# breaks <img> tags. When unset, srcSetFor() returns the original object URL.
VITE_SUPABASE_IMAGE_TRANSFORMS=false

# --- Playwright e2e ---
E2E_TESTER_EMAIL=
E2E_TESTER_PASSWORD=
