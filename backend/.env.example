# Supabase project — server-side only.
# SUPABASE_SECRET_KEY is the new sb_secret_… style key from
# Project Settings → API. Never commit a real value here; this file is
# a template that backend/setup.sh and developers copy to backend/.env.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_PASTE_YOUR_SECRET_KEY_HERE

# JWT signing key for any backend-issued tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=PASTE_A_STRONG_RANDOM_STRING_HERE

# CORS allowlist — JSON array of origins. Defaults to vite dev server.
ALLOWED_ORIGINS=["http://localhost:5173"]

# Optional CORS origin regex, applied in addition to ALLOWED_ORIGINS.
# Used in production to allow Vercel preview deploys (which get a fresh
# subdomain per branch) without redeploying the backend each time.
# Leave commented out for local dev. Example for Railway:
#   ALLOWED_ORIGIN_REGEX=^https://tiger-english-[a-z0-9-]+\.vercel\.app$

# Environment label, propagated into logs/error responses.
ENVIRONMENT=development

# Anthropic API key. Required (alongside AI_TUTOR_ENABLED=true below) for
# /me/ai-tutor/* and /me/conversations/turn to work. Without it those routes
# return 503 + {code: "ai_disabled"} so the frontend can render its degraded UI.
# Committed templates / bootstrap scripts should leave this blank or use a
# value starting with "sk-ant-placeholder" so they aren't mistaken for real keys.
ANTHROPIC_API_KEY=

# AI Tutor speech feature (Spec 1+). Master opt-in flag — both AI_TUTOR_ENABLED
# and ANTHROPIC_API_KEY are required for /me/ai-tutor/* + /me/conversations/turn.
AI_TUTOR_ENABLED=false

# Groq Whisper API (STT). Required when AI_TUTOR_ENABLED=true.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
STT_PROVIDER=stub  # 'groq' in production
STT_TIMEOUT_SECONDS=10
TUTOR_AUDIO_BUCKET=ai-tutor-audio

# ElevenLabs (script-side only; used by scripts/generate-tutor-audio.ts).
# Not read at runtime by FastAPI.
ELEVEN_LABS_API_KEY=

# Opt-in: when AI is disabled (no ANTHROPIC_API_KEY), serve a heuristic
# mock from /me/ai-tutor/writing-coach instead of 503. Useful for demoing
# the full Writing Coach UI without an API key. Default false keeps the
# endpoint consistent with sibling AI tutor routes.
AI_WRITING_COACH_MOCK_WHEN_DISABLED=false

# Leonardo AI key, only needed by scripts/generate-lesson-images.ts.
# Optional for the FastAPI runtime; leave blank if you're not running
# the lesson-image pipeline locally.
LEONARDO_API_KEY=
