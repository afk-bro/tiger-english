# Supabase project — server-side only.
# SUPABASE_SECRET_KEY is the new sb_secret_… style key from
# Project Settings → API. Never commit a real value here; this file is
# a template that backend/setup.sh and developers copy to backend/.env.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_PASTE_YOUR_SECRET_KEY_HERE

# JWT signing key for any backend-issued tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=PASTE_A_STRONG_RANDOM_STRING_HERE

# CORS allowlist — JSON array of origins. Defaults to vite dev server.
ALLOWED_ORIGINS=["http://localhost:5173"]

# Environment label, propagated into logs/error responses.
ENVIRONMENT=development

# Leonardo AI key, only needed by scripts/generate-lesson-images.ts.
# Optional for the FastAPI runtime; leave blank if you're not running
# the lesson-image pipeline locally.
LEONARDO_API_KEY=
